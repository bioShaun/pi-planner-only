+	if (/^-\s+-\s/m.test(numstat)) throw new Error("binary changes cannot be reviewed as text");
+	const diff = await reviewCommand(root, ["diff", ...flags, mergeBase, head, "--"]);
+	if (!diff) throw new Error("empty range diff");
