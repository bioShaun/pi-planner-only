+	const records = raw.split("\0");
+	const blobs = new Set<string>();
+	for (let i = 0; i < records.length - 1; i += 2) {
+		const record = /^:(\d{6}) (\d{6}) ([0-9a-f]+) ([0-9a-f]+) [A-Z]$/.exec(records[i]);
