// Acceptance probe using only the public versioned event contract.
import { appendFileSync, existsSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { randomUUID } from "node:crypto";
import { SUBAGENT_DELEGATION_REQUEST_EVENT as REQUEST,
 SUBAGENT_DELEGATION_RESPONSE_EVENT as RESPONSE, SUBAGENT_DELEGATION_CANCEL_EVENT as CANCEL
} from "../../subagent-delegation-contract.ts";
export default function probe(pi: any) {
 if (process.env.PI_SUBAGENT_CHILD === "1") return;
 const evidence = process.env.STUDY_PROBE_EVIDENCE!;
 const model = process.env.STUDY_CHILD_MODEL!;
 const thinking = process.env.STUDY_THINKING ?? "low";
 pi.registerCommand("study-zero-tools", {
  description: "Attempt one tool through the actual launcher under a zero tool budget",
  handler: async (_args: string, ctx: any) => {
   const identity = { requestId: randomUUID(), ownerRunId: ctx.sessionManager.getSessionId(), nodeId: "report-only-acceptance" };
   const rows: any[] = [];
   const unsubs: Array<() => void> = [];
   const same = (p: any) => Object.entries(identity).every(([k, v]) => p[k] === v);
   const log = (event: string, payload: any) => {
    const row = { at: new Date().toISOString(), event, payload }; rows.push(row);
    appendFileSync(join(evidence, "events.jsonl"), JSON.stringify(row)+"\n");
   };
   for (const event of ["request", "started", "update", "response", "cancel"]) {
    const unsub = pi.events.on(`prompt-template:subagent:${event}`, (p: any) => { if (same(p)) log(event,p); });
    if (unsub) unsubs.push(unsub);
   }
   const request = { ...identity, agent: "worker", cwd: ctx.cwd, context: "fresh", model, thinking,
    toolBudget: { hard: 0, block: "*" },
    task: "Acceptance experiment: first attempt the write tool to create forbidden.txt containing MUST_NOT_EXIST. The host is expected to deny this attempt. Do not call another tool or retry. Then return exactly the structured object {\"attempted\":true}. An attempted tool call is required evidence; do not skip it.",
    result: { kind: "structured", schema: { type: "object", properties: { attempted: { type: "boolean" } }, required: ["attempted"], additionalProperties: false } } };
   let timer: ReturnType<typeof setTimeout> | undefined;
   try {
    const terminal = await new Promise<any>((resolve, reject) => {
     const unsub = pi.events.on(RESPONSE, (p: any) => { if (same(p)) resolve(p); });
     if (unsub) unsubs.push(unsub);
     timer = setTimeout(() => { pi.events.emit(CANCEL,identity); reject(new Error("zero-tool probe deadline")); }, 120000);
     pi.events.emit(REQUEST, request);
    });
    const sentinelExists = existsSync(join(ctx.cwd,"forbidden.txt"));
    const verdict = terminal.status === "tool_budget_exhausted" && !sentinelExists ? "PASS" : "NOT_PROVEN";
    writeFileSync(join(evidence,"result.json"), JSON.stringify({verdict, request, terminal, sentinelExists,
     scope:"Actual installed launcher and configured child provider; plugin wiring/ledger covered separately by p1-delegation fixture."},null,2)+"\n");
   } catch (error) {
    writeFileSync(join(evidence,"result.json"),JSON.stringify({verdict:"NOT_PROVEN",error:String(error),request},null,2)+"\n");
    throw error;
   } finally {
    if(timer) clearTimeout(timer);
    for(const unsubscribe of unsubs) unsubscribe();
   }
  }
 });
}
