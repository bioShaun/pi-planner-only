command: cat /project/tmp/pi-native-lite-20261027/check-links.cjs
const fs = require('fs');
const path = require('path');
const root = '.scratch/native-lite-comparison';
const files = fs.readdirSync(root).filter(f => f.endsWith('.md') && f !== 'root-brief.md').map(f => path.join(root, f));
const archive = fs.readdirSync(path.join(root, 'archive')).filter(f => f.endsWith('.md')).map(f => path.join(root, 'archive', f));
let missing = 0, total = 0;
for (const file of [...files, ...archive]) {
  const text = fs.readFileSync(file, 'utf8');
  for (const match of text.matchAll(/\]\(([^)]+)\)/g)) {
    let target = match[1].trim().split(/\s+/)[0].replace(/^<|>$/g, '');
    if (/^(?:[a-z]+:|#|\/\/)/i.test(target)) continue;
    target = decodeURI(target.split('#')[0]);
    if (path.isAbsolute(target) && file.endsWith('/review-initial.md')) target = target.replace(/:\d+$/, '');
    if (!target) continue;
    total++;
    const exists = fs.existsSync(path.resolve(path.dirname(file), target));
    if (!exists) { missing++; console.log(`MISSING ${file} -> ${target}`); }
  }
}
console.log(`checked=${total} missing=${missing}`);
process.exitCode = missing ? 1 : 0;
actual_exit=0

